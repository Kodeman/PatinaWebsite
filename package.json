{
  "name": "patina-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:cloudflare": "node scripts/cloudflare-build.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview --port 8787",
    "deploy:cloudflare": "opennextjs-cloudflare deploy --keep-vars",
    "check:production-env": "node scripts/check-production-env.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@portabletext/react": "^6.0.3",
    "@sanity/image-url": "^2.0.2",
    "@sanity/vision": "^5.1.0",
    "@supabase/supabase-js": "^2.98.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "next": "16.3.4",
    "next-sanity": "13.3.4",
    "posthog-js": "^1.356.1",
    "posthog-node": "^5.26.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^5.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "4.130.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    },
    "sharp": "0.35.4",
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.0"
    }
  }
}
